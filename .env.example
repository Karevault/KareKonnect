## Server
# Public URL (also editable in Admin → Deployment & integrations; DB value wins when set).
HC_BASE_URL=http://localhost:8000
HC_DEFAULT_TIMEZONE=Africa/Lagos

## Database (Postgres)
DATABASE_URL=postgresql+psycopg2://healthconnect:healthconnect@localhost:5432/healthconnect
HC_DB_NAME=healthconnect
HC_DB_USER=healthconnect
HC_DB_PASS=healthconnect
HC_DB_HOST=localhost
HC_DB_PORT=5432

## Admin
# Secret used to sign the admin session cookie (set a long random value in production).
HC_ADMIN_SESSION_SECRET=change-me
# Optional fallback if HC_ADMIN_SESSION_SECRET is unset:
HC_SESSION_SECRET=change-me

## WhatsApp (patient wa.me — digits only, no +). With Meta Cloud API set, join page uses Meta’s
## display number from Graph; set this for Twilio-only WA or if Graph lookup is unavailable.
HC_WHATSAPP_NUMBER=

## Meta WhatsApp Cloud API (optional) — https://developers.facebook.com/docs/whatsapp/cloud-api
# Webhook in Meta console: GET+POST {HC_BASE_URL}/webhooks/meta/whatsapp
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=
META_WA_ACCESS_TOKEN=
# Random string you choose; must match Meta "Verify token" field.
META_WA_VERIFY_TOKEN=
# App Secret from Meta app dashboard — required to validate X-Hub-Signature-256 in production.
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

## Twilio (optional; WhatsApp + SMS when AT is not used for SMS)
# Inbound: POST {HC_BASE_URL}/webhooks/twilio/inbound
# Delivery status: POST {HC_BASE_URL}/webhooks/twilio/status (set on Messaging Service + auto on outbound when HTTPS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Twilio number patients TEXT TO for SMS JOIN (E.164 or digits). Must be the number whose inbound
# webhook is POST {HC_BASE_URL}/webhooks/twilio/inbound (often a number on your Messaging Service).
HC_SMS_JOIN_NUMBER=

## Africa's Talking (optional SMS + USSD) — https://developers.africastalking.com/
# Outbound SMS uses AT when these are set (otherwise Twilio for SMS if Twilio is configured).
AT_USERNAME=
AT_API_KEY=
AT_SHORTCODE=
# Callbacks (set in AT dashboard; must match HC_BASE_URL):
#   POST {HC_BASE_URL}/webhooks/africastalking/sms
#   POST {HC_BASE_URL}/webhooks/africastalking/ussd

## Google Cloud Translation API (optional fallback) — used after DB cache and your ML service.
# Enable "Cloud Translation API" on the key’s project.
GOOGLE_TRANSLATE_API_KEY=
# Same key can be used for WhatsApp voice STT/TTS if Speech-to-Text + Text-to-Speech APIs are enabled,
# or set GOOGLE_CLOUD_API_KEY separately.
# GOOGLE_CLOUD_API_KEY=

## WhatsApp voice notes (Meta Cloud API + Google STT/TTS)
# HC_WHATSAPP_VOICE_INBOUND=1   — voice note → transcript → same router as text (default on)
# HC_WHATSAPP_VOICE_OUTBOUND=0  — patients must send VOICE YES; short replies as audio (default off)
# HC_WHATSAPP_VOICE_MAX_CHARS=400
# Admin → Channel Settings: whatsapp_voice_* toggles override env when set on app_settings row.

## First-party translation ML — bundled on this app at POST /v1/detect and POST /v1/translate (requires HC_TRANSLATION_ML_API_KEY).
# Set HC_TRANSLATION_ML_BASE_URL to the same HTTPS origin as HC_BASE_URL so calls stay in-process (no separate Railway service required).
# Or point it at another host that implements the same JSON contract (see app/translation_ml.py).
# HC_TRANSLATION_ML_BASE_URL=https://your-host.example.com
# HC_TRANSLATION_ML_API_KEY=
# HC_TRANSLATION_ML_MODEL_VERSION=v1
# HC_TRANSLATION_ML_MIN_CONFIDENCE=0.45
# Append-only training rows in translation_learning_samples (set 0/false to disable).
# HC_TRANSLATION_RECORD_LEARNING=1
# Optional: override FastText lid path (default: ml_cache/lid.176.ftz after scripts/download_ml_assets.py).
# FASTTEXT_LID_PATH=
# Hugging Face Hub cache for Pidgin Marian only (Railway build: HC_PREFETCH_MARIAN=pcm).
# HF_HOME=/app/ml_cache/hf_hub
# HC_PREFETCH_MARIAN=pcm
# HC_PCM_TRANSLATE_TIMEOUT_SEC=18
# HC_INBOUND_ROUTING_TIMEOUT_SEC=28
# Max OPUS-MT models kept in RAM at once (LRU); default 2.
# HC_NEURAL_MAX_LOADED_MODELS=2

## Clinical triage — OCR, vision, reasoning (Google Vision uses GOOGLE_CLOUD_API_KEY or GOOGLE_TRANSLATE_API_KEY)
# HC_CLINICAL_INTELLIGENCE_ENABLED=1
# HC_TRIAGE_WINDOW_HOURS=72
# HC_TRIAGE_INACTIVITY_TIMEOUT_MINUTES=10
# HC_ATTACHMENTS_DIR=data/attachments
# Action paths: app/content/clinical_action_paths.json (customize per deployment)

## KareVault EHR — https://ehr.karevault.com/api/docs
# HC_EHR_API_BASE_URL=https://ehr.karevault.com
# Partner API key (Setup → Partner API keys): lookup/create patient, next-of-kin
# HC_EHR_PARTNER_API_KEY=
# WhatsApp Teleconsult bearer: clinical context, glucose, meds, incidents, observations
# HC_EHR_TELECONSULT_API_KEY=
# Optional fallback if both keys are the same:
# HC_EHR_API_KEY=
#
# Partner (KareConnect): GET /api/partners/patients/lookup, POST /api/partners/patients,
#   GET /api/partners/patients/{id}/next-of-kin,
#   GET /api/partners/appointments/availability, POST /api/partners/appointments
# Teleconsult: GET /api/external/patient/{id}/context,
#   GET /api/external/patients/{id}/glucose-readings|medication,
#   POST /api/external/incidents, POST /api/external/observation
# Kareconnect stores user_id ↔ EHR patients.id in ehr_patient_links.
# Next of kin is per patient (patient_next_of_kin.user_id), synced from EHR on lookup.

## KareVault Telehealth (WhatsApp doctor directory, availability, booking, reschedule)
# HC_TELEHEALTH_API_BASE_URL=https://telehealthapi.karevault.com
# HC_TELEHEALTH_WHATSAPP_TOKEN=
# When set, TELEHEALTH and APPOINT's video-consultation path list real doctors/specialties/
# fees and real open slots from this API instead of the local Admin → Telehealth → Providers
# seed list (which is local-dev/fallback only once this is configured).

## Emergency & on-call clinical actions
# HC_EMERGENCY_HOTLINE=122
# HC_ON_CALL_CLINICIAN_PHONE=+234...  (or set in Admin → Deployment & integrations)

## OPay (telehealth consultation payments)
# Callback (required): set as the notification URL in the OPay merchant dashboard →
# POST https://kareconnect.karevault.com/webhooks/opay
# Method: hosted Cashier checkout link (card, bank transfer, USSD, OPay wallet on OPay's page).
# HC_OPAY_ENV=sandbox  (use OPay's testapi.opaycheckout.com base while testing; default is live)
OPAY_SECRET_KEY=
OPAY_PUBLIC_KEY=
OPAY_MERCHANT_ID=

## Meta WhatsApp Calling API (optional — business-initiated video after payment)
# Enable in Admin → Deployment & integrations, or:
# HC_META_WA_CALLING_ENABLED=1
# Optional WebRTC bridge POST {session_id,to} → {sdp} for /calls connect:
# HC_META_WA_CALLING_WEBRTC_BRIDGE_URL=

## Optional: operator notification webhook (helpdesk + telehealth events)
HC_OPERATOR_WEBHOOK_URL=
# Helpdesk staff E.164 — SMS/WA alerts per ticket (same channel as patient); reply: TKT <ticket_id> text
HC_HELPDESK_PHONE=

## KareVault symptom checker (optional) — https://symptoms-checker.karevault.com/api/docs/
# When enabled, helpdesk flow still opens a ticket, then adds AI text after FAQ (or as the main reply if no FAQ).
# HC_KAREVAULT_ENABLED=1
# HC_KAREVAULT_BASE_URL=https://symptoms-checker.karevault.com
# Recommended: partner access (unique email per deployment; creates a KareVault partner user).
# HC_KAREVAULT_PARTNER_EMAIL=healthconnect@yourdomain.org
# HC_KAREVAULT_PARTNER_NAME=Kareconnect
# If HC_KAREVAULT_PARTNER_EMAIL is unset but HC_KAREVAULT_ENABLED=1, the app uses public POST /api/ai/chat/ (no token; demos only).
